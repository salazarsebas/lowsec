# Copy to .env (never commit .env)
NEAR_NETWORK=testnet
CONTRACT_ID=lowsec.testnet
COUNCIL_ID=council.lowsec.testnet
RELAYER_ID=relayer.lowsec.testnet
# Private keys are read from ~/.near-credentials/testnet/<account>.json by default.
# Optionally override (never commit real values):
RELAYER_PRIVATE_KEY=
# NEAR AI Cloud (https://cloud.near.ai). Leave empty to run in MOCK mode.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash
MOCK_MODE=1
