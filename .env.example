# Copy to .env at the repo root (never commit .env). Every value has a working testnet default.
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
CONTRACT_ID=lowsec.testnet
COUNCIL_ID=lowsec-council.testnet
RELAYER_ID=lowsec-relayer.testnet
PORT=8787

# NEAR AI Cloud (https://cloud.near.ai). Empty => NPC/Council brains run in clearly labelled MOCK mode.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash

# Keys are read from ~/.near-credentials/testnet/ by default (full keys: <account>.json;
# function-call keys from `pnpm setup-keys`: lowsec-fc/<role>.<account>.json).
# On a host without that folder (Railway/Fly/Render), set them as secrets instead:
RELAYER_PRIVATE_KEY=
ONBOARDER_PRIVATE_KEY=
COUNCIL_PRIVATE_KEY=
HAULER_1_PRIVATE_KEY=
HAULER_2_PRIVATE_KEY=

# Web (apps/web): where the Node server lives when the web is hosted separately (e.g. Vercel)
LOWSEC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_CONTRACT_ID=lowsec.testnet
